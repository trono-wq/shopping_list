<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAIN ACTION BAR - Layout, Position-->
    <LinearLayout
        android:id="@+id/main_action_bar"

        android:gravity="center"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:orientation="horizontal"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- MAIN COMPLETE - Layout, Font -->
        <TextView
            android:id="@+id/complete"
            android:text="@string/complete"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="5dp"
            android:textColor="#ff8000"
            android:textSize="25sp"
            android:textStyle="bold"/>

        <!-- SEPARATOR - Layout, Font -->
        <TextView
            android:text="@string/separator"

            android:layout_height="wrap_content"
            android:layout_width="wrap_content"

            android:padding="3dp"
            android:textColor="#dc6500"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <!-- SHOPPING - Layout, Font, Interact-->
        <TextView
            android:id="@+id/shopping"
            android:text="@string/shopping"

            android:layout_height="wrap_content"
            android:layout_width="wrap_content"

            android:padding="5dp"
            android:textColor="#dc6500"
            android:textSize="15sp"

            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- SCROLL -->
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/main_action_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- SCROLL LAYOUT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- SEARCH - Layout, Design, Font-->
            <EditText
                android:id="@+id/search"

                android:layout_height="40dp"
                android:layout_width="match_parent"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_marginTop="15dp"
                android:padding="10dp"

                android:background="@drawable/search_background"
                android:hint="@string/search"
                android:importantForAutofill="no"
                android:inputType="text"
                android:textColorHint="#666666"

                android:textColor="#FFFFFF"
                android:textSize="15sp"/>

            <!-- PLACES ACTION BAR -->
            <LinearLayout
                android:id="@+id/places_action_bar"

                android:gravity="center"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="40dp">

                <!-- SORT ALPHABETICALLY - Layout, Font -->
                <TextView
                    android:id="@+id/sort_alphabetically"
                    android:text="@string/sort_alphabetically"

                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"

                    android:padding="5dp"
                    android:textColor="#666666"
                    android:textSize="15sp"

                    android:clickable="true"
                    android:focusable="true"/>

                <!-- S2 - Layout, Font -->
                <TextView
                    android:text="@string/s2"

                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"

                    android:padding="3dp"
                    android:textColor="#666666"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <!-- ADD PLACE - Layout, Font, Interact-->
                <TextView
                    android:id="@+id/add_place"
                    android:text="@string/add_place"

                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"

                    android:padding="5dp"
                    android:textColor="#666666"
                    android:textSize="15sp"

                    android:clickable="true"
                    android:focusable="true"/>

                <!-- PLACES DROPDOWN -->

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>