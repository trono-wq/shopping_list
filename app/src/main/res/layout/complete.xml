<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:id="@+id/top_section"

        android:gravity="start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/action_bar"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/a_complete"
                android:text="@string/a_complete"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:textColor="#ff8000"
                android:textSize="25sp"
                android:textStyle="bold"/>

            <TextView
                android:text="@string/a_separator"

                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:padding="5dp"
                android:textColor="#dc6500"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/a_shopping"
                android:text="@string/a_shopping"

                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:padding="5dp"
                android:textColor="#dc6500"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:text="@string/a_separator"

                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:padding="5dp"
                android:textColor="#dc6500"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/a_gucci_mane"
                android:text="@string/a_gucci_mane"

                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:padding="5dp"
                android:textColor="#dc6500"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/search_bar"

            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="5dp">

            <EditText
                android:id="@+id/a_search"
                android:background="@drawable/search_background"
                android:hint="@string/a_search"

                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:padding="10dp"
                android:importantForAutofill="no"
                android:inputType="text"
                android:textColorHint="#999999"
                android:textColor="#FFFFFF"
                android:textSize="15sp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/c_edit"
                android:text="@string/c_edit"

                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:backgroundTint="#666666"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll_view"

        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="10dp"

        app:layout_constraintTop_toBottomOf="@id/top_section"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:id="@+id/scroll"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:fillViewport="true"

            app:layout_constraintTop_toBottomOf="@id/top_section">

        <LinearLayout
            android:id="@+id/group"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/place_section"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/edit_place_bar"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/c_p_sort"
                        android:text="@string/c_p_sort"

                        android:layoutDirection="rtl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"

                        android:textColor="#666666"
                        android:textSize="15sp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/c_p_add_all_list"

                        android:backgroundTint="#666666"
                        android:textColor="#1d1b20"
                        android:layout_width="100dp"
                        android:layout_height="40dp"
                        android:text="@string/c_p_add_all_list"
                        android:padding="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textAllCaps="false"
                        android:layout_gravity="center_vertical"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/place_bar"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="7dp"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/a_p_expand"

                        android:layout_width="35dp"
                        android:layout_height="40dp"
                        android:backgroundTint="#666666"
                        android:text="@string/a_p_expand"
                        android:textSize="20sp"
                        android:textColor="#1d1b20"
                        android:padding="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/a_p_name"
                        android:text="@string/a_p_name"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:layout_weight="1"
                        android:textStyle="bold"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/c_p_remove"

                        android:backgroundTint="#666666"
                        android:textColor="#1d1b20"
                        android:layout_width="35dp"
                        android:layout_height="40dp"
                        android:text="@string/c_p_remove"
                        android:textSize="25sp"
                        android:padding="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:gravity="center"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/c_p_add"

                        android:backgroundTint="#666666"
                        android:textColor="#1d1b20"
                        android:layout_width="35dp"
                        android:layout_height="40dp"
                        android:text="@string/c_p_add"
                        android:textSize="25sp"
                        android:padding="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:gravity="center"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/c_p_add_list"

                        android:backgroundTint="#666666"
                        android:textColor="#1d1b20"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="@string/c_p_add_list"
                        android:padding="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textAllCaps="false"
                        android:layout_gravity="center_vertical"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/c_p_edit"

                        android:layout_width="35dp"
                        android:layout_height="40dp"
                        android:backgroundTint="#1d1b20"
                        android:text="@string/c_p_edit"
                        android:textSize="25sp"
                        android:textColor="#666666"
                        android:padding="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:gravity="center"/>
                </LinearLayout>
            </LinearLayout>

                <LinearLayout
                    android:id="@+id/category_section"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="30dp">

                    <LinearLayout
                        android:id="@+id/edit_category_bar"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/c_c_sort"
                            android:text="@string/c_c_sort"

                            android:layoutDirection="rtl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"

                            android:textColor="#666666"
                            android:textSize="15sp"
                            android:clickable="true"
                            android:focusable="true"/>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/c_c_add_all_list"

                            android:backgroundTint="#666666"
                            android:textColor="#1d1b20"
                            android:layout_width="100dp"
                            android:layout_height="40dp"
                            android:text="@string/c_c_add_all_list"
                            android:padding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:textAllCaps="false"
                            android:layout_gravity="center_vertical"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/category_bar"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginStart="7dp"
                        android:gravity="center_vertical">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/a_c_expand"

                            android:layout_width="35dp"
                            android:layout_height="40dp"
                            android:backgroundTint="#666666"
                            android:text="@string/a_c_expand"
                            android:textSize="20sp"
                            android:textColor="#1d1b20"
                            android:padding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:gravity="center"/>

                        <TextView
                            android:id="@+id/a_c_name"
                            android:text="@string/a_c_name"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="5dp"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:layout_weight="1"
                            android:textStyle="italic"/>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/c_c_remove"

                            android:backgroundTint="#666666"
                            android:textColor="#1d1b20"
                            android:layout_width="35dp"
                            android:layout_height="40dp"
                            android:text="@string/c_p_remove"
                            android:textSize="25sp"
                            android:padding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:gravity="center"/>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/c_c_add"

                            android:backgroundTint="#666666"
                            android:textColor="#1d1b20"
                            android:layout_width="35dp"
                            android:layout_height="40dp"
                            android:text="@string/c_p_add"
                            android:textSize="25sp"
                            android:padding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:gravity="center"/>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/c_c_add_list"

                            android:backgroundTint="#666666"
                            android:textColor="#1d1b20"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="@string/c_p_add_list"
                            android:padding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:textAllCaps="false"
                            android:layout_gravity="center_vertical"/>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/c_c_edit"

                            android:layout_width="35dp"
                            android:layout_height="40dp"
                            android:backgroundTint="#1d1b20"
                            android:text="@string/c_p_edit"
                            android:textSize="25sp"
                            android:textColor="#666666"
                            android:padding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:gravity="center"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/item_section"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/edit_item_bar"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginStart="60dp">

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/c_i_sort"
                            android:text="@string/c_i_sort"

                            android:layoutDirection="rtl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"

                            android:textColor="#666666"
                            android:textSize="15sp"
                            android:clickable="true"
                            android:focusable="true"/>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/c_i_add_all_list"

                            android:backgroundTint="#666666"
                            android:textColor="#1d1b20"
                            android:layout_width="100dp"
                            android:layout_height="40dp"
                            android:text="@string/c_i_add_all_list"
                            android:padding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:textAllCaps="false"
                            android:layout_gravity="center_vertical"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/item_bar"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginStart="67dp"
                        android:gravity="center_vertical">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/a_i_expand"

                            android:layout_width="35dp"
                            android:layout_height="40dp"
                            android:backgroundTint="#666666"
                            android:text="@string/a_i_expand"
                            android:textSize="20sp"
                            android:textColor="#1d1b20"
                            android:padding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:gravity="center"/>

                        <TextView
                            android:id="@+id/a_i_name"
                            android:text="@string/a_i_name"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="5dp"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:layout_weight="1"/>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/c_i_remove"

                            android:backgroundTint="#666666"
                            android:textColor="#1d1b20"
                            android:layout_width="35dp"
                            android:layout_height="40dp"
                            android:text="@string/c_p_remove"
                            android:textSize="25sp"
                            android:padding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:gravity="center"/>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/c_i_add"

                            android:backgroundTint="#666666"
                            android:textColor="#1d1b20"
                            android:layout_width="35dp"
                            android:layout_height="40dp"
                            android:text="@string/c_p_add"
                            android:textSize="25sp"
                            android:padding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:gravity="center"/>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/c_i_add_list"

                            android:backgroundTint="#666666"
                            android:textColor="#1d1b20"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="@string/c_p_add_list"
                            android:padding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:textAllCaps="false"
                            android:layout_gravity="center_vertical"/>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/c_i_edit"

                            android:layout_width="35dp"
                            android:layout_height="40dp"
                            android:backgroundTint="#1d1b20"
                            android:text="@string/c_p_edit"
                            android:textSize="25sp"
                            android:textColor="#666666"
                            android:padding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:gravity="center"/>

                    </LinearLayout>

                    <TableLayout
                        android:id="@+id/item_brand_bar"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:stretchColumns="0,2,4,6">

                        <TableRow
                            android:gravity="center_vertical"
                            android:fillViewport="true"
                            app:layout_constraintTop_toBottomOf="@id/item_bar">

                            <TextView
                                android:id="@+id/a_b_brand"
                                android:text="@string/a_b_brand"

                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:padding="5dp"
                                android:gravity="center"
                                android:textColor="#999999"
                                android:textSize="10sp"/>

                            <TextView
                                android:text="@string/a_s2"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#999999"
                                android:textSize="20sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/a_b_name"
                                android:text="@string/a_b_name"

                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:padding="5dp"
                                android:gravity="center"
                                android:textColor="#999999"
                                android:textSize="10sp"/>

                            <TextView
                                android:text="@string/a_s2"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#999999"
                                android:textSize="20sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/a_b_weight"
                                android:text="@string/a_b_weight"

                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:padding="5dp"
                                android:gravity="center"
                                android:textColor="#999999"
                                android:textSize="10sp"/>

                            <TextView
                                android:text="@string/a_s2"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#999999"
                                android:textSize="20sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/a_b_quantity"
                                android:text="@string/a_b_quantity"

                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:padding="5dp"
                                android:gravity="center"
                                android:textColor="#999999"
                                android:textSize="10sp"/>

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/c_i_b_remove"

                                android:backgroundTint="#1d1b20"
                                android:textColor="#666666"
                                android:layout_width="35dp"
                                android:layout_height="40dp"
                                android:text="@string/c_p_remove"
                                android:textSize="25sp"
                                android:padding="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:gravity="center"/>

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/c_i_b_add"

                                android:backgroundTint="#1d1b20"
                                android:textColor="#666666"
                                android:layout_width="35dp"
                                android:layout_height="40dp"
                                android:text="@string/c_p_add"
                                android:textSize="25sp"
                                android:padding="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:gravity="center"/>

                        </TableRow>
                    </TableLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>